{
  "name": "paper-album-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Paper Album UI — a layered-paper React design system for photography portfolios, aligned with shadcn/ui.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "tokens": "node scripts/tokens.mjs",
    "predev": "npm run tokens",
    "dev": "vite",
    "prebuild": "npm run tokens",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "npm run tokens && tsc -b --noEmit",
    "lint": "eslint .",
    "pretest:unit": "npm run tokens",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "0.577.0",
    "marked": "18.0.14",
    "radix-ui": "1.6.7",
    "react": "18.3.1",
    "react-day-picker": "9.14.0",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "react-resizable-panels": "3.0.6",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
